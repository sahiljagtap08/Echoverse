*.db-journal

# Secrets — never commit
secrets/
*_sas_uri.txt

# Non-releasing Echo envs kept locally for video capture (never ship)
other_envs/

# Eval run outputs and logs (generated by the harness; can be huge — never ship)
runs/
logs/

# Regenerated on every `npm install`; churns constantly, not tracked.
envs/*/frontend/package-lock.json

# Local model weights (large; never commit)
models/
